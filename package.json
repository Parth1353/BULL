{
  "name": "bull-ai-financial-research",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"pnpm worker\"",
    "build": "next build",
    "start": "concurrently -k \"npm run start:web\" \"npm run worker\"",
    "start:web": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "worker": "tsx src/worker.ts",
    "examples": "DEMO_MODE=true tsx scripts/generate-examples.ts",
    "examples:live": "tsx scripts/generate-live-examples.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@react-pdf/renderer": "^4.3.1",
    "concurrently": "^9.2.1",
    "d3-scale": "^4.0.2",
    "dotenv": "^16.6.1",
    "groq-sdk": "^1.4.0",
    "next": "^15.5.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
