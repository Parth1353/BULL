{
  "name": "bull-ai-financial-research",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"npm run worker\"",
    "build": "next build",
    "start": "concurrently -k \"npm run start:web\" \"npm run worker\"",
    "start:web": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "worker": "tsx src/worker.ts",
    "generate": "tsx scripts/generate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "parse-check": "tsx scripts/dev/parse-check.ts",
    "render-check": "tsx scripts/dev/render-check.ts",
    "schema-check": "tsx scripts/dev/schema-check.ts",
    "models": "tsx scripts/dev/models.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@react-pdf/renderer": "^4.3.1",
    "concurrently": "^9.2.1",
    "d3-scale": "^4.0.2",
    "dotenv": "^16.6.1",
    "next": "^15.5.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
