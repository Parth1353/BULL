# Create a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Set true to run the upload workflow against built-in fixtures without an API key.
DEMO_MODE=false
MAX_UPLOAD_MB=15
# In Railway, set this to the mounted persistent-volume path, for example /data.
STORAGE_ROOT=storage
