# Required. Create a key at https://aistudio.google.com/apikey
# Keep this server-side only; it is never exposed to the browser.
GEMINI_API_KEY=

# Extraction model. The default is the current generally-available flagship.
# For the highest extraction quality on dense tables, gemini-3.1-pro-preview
# scores better but is a preview model and may be retired.
GEMINI_MODEL=gemini-3.6-flash

# Reasoning depth: MINIMAL | LOW | MEDIUM | HIGH (model dependent).
GEMINI_THINKING_LEVEL=HIGH

# Upload ceiling for the web UI.
MAX_UPLOAD_MB=20

# Characters of parsed source text sent to the model per extraction pass.
MAX_SOURCE_CHARS=400000

# Where SQLite state, uploads and generated PDFs live.
# On Railway, point this at the mounted volume, for example /data.
STORAGE_ROOT=storage
